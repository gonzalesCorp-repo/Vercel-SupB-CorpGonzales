<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
  id="Definitions_Lab_Suministros" 
  targetNamespace="http://bpmn.io/schema/bpmn" 
  exporter="Vaikuntha ERP Bizagi BPMN Generator" 
  exporterVersion="2.2">
  <bpmn:collaboration id="Collaboration_Lab_Suministros">
    <bpmn:participant id="Participant_Lab_Suministros" name="Cadena de Suministro y Laboratorio Químico - Vaikuntha ERP" processRef="Process_Lab_Suministros" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Lab_Suministros" name="Cadena de Suministro y Laboratorio Químico - Vaikuntha ERP" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Lab_Suministros">
      <bpmn:lane id="Lane_Lab_Estil" name="Estilista Solicitante">
        <bpmn:flowNodeRef>Start_Lab_Req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_Formulacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_RecibeBowl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_Aplicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Estil_TimerExp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_Sobrante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lab_Serv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lab_Quimico" name="Encargado de Laboratorio">
        <bpmn:flowNodeRef>Task_Lab_MonitorDespacho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Lab_ConnectBalanza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Lab_TaraPesaje</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Lab_Tolerancia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Lab_ConfirmarDespacho</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lab_Kardex" name="Motor de Inventario &amp; Kardex">
        <bpmn:flowNodeRef>Task_Kardex_Deduccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Kardex_Minimo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kardex_Alerta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lab_Compras" name="Administración &amp; Compras">
        <bpmn:flowNodeRef>Task_Compras_OpalPredictor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compras_GenerarOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lab_StockOk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataObject id="DO_DO_Lab_Formula" />
    <bpmn:dataObjectReference id="DO_Lab_Formula" name="Ticket de Fórmula Química (Gramaje)" dataObjectRef="DO_DO_Lab_Formula">
      <bpmn:documentation>Especificación de tintes, decolorantes y peróxidos solicitados.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DS_Lab_Kardex" name="(BD) Supabase: public.inventario_movimientos">
      <bpmn:documentation>Kardex continuo con auditoría de salidas por consumo de salón.</bpmn:documentation>
    </bpmn:dataStoreReference>

    <bpmn:startEvent id="Start_Lab_Req" name="Necesidad de Mezcla Química">
      <bpmn:documentation>Estilista diagnostica servicio (tinte, decoloración, plex).</bpmn:documentation>
      <bpmn:outgoing>Lab_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Estil_Formulacion" name="Selección de Fórmula &amp; Gramaje en Móvil">
      <bpmn:documentation>Ingreso de código de producto y gramos proyectados en app.</bpmn:documentation>
      <bpmn:incoming>Lab_F1</bpmn:incoming>
      <bpmn:outgoing>Lab_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Estil_RecibeBowl" name="Recepción de Bowl de Mezcla">
      <bpmn:documentation>Estilista recibe el bowl listo para aplicar en el cliente.</bpmn:documentation>
      <bpmn:incoming>Lab_F8</bpmn:incoming>
      <bpmn:outgoing>Lab_F10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Estil_Aplicar" name="Aplicación en Cabello">
      <bpmn:documentation>Aplicación química en el sillón.</bpmn:documentation>
      <bpmn:incoming>Lab_F10</bpmn:incoming>
      <bpmn:outgoing>Lab_F11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Event_Estil_TimerExp" name="Cronómetro Químico (20-45 min)">
      <bpmn:documentation>Control estricto de tiempo de exposición para no maltratar la hebra capilar.</bpmn:documentation>
      <bpmn:incoming>Lab_F11</bpmn:incoming>
      <bpmn:outgoing>Lab_F12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Event_Estil_TimerExp">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT35M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Estil_Sobrante" name="Declaración de Sobrante o Merma">
      <bpmn:documentation>Registra si sobró producto para auditoría de desperdicio.</bpmn:documentation>
      <bpmn:incoming>Lab_F12</bpmn:incoming>
      <bpmn:outgoing>Lab_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Lab_Serv" name="Aplicación Química Concluida">
      <bpmn:documentation>Servicio químico aplicado exitosamente.</bpmn:documentation>
      <bpmn:incoming>Lab_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Lab_MonitorDespacho" name="Monitor de Despacho (/lab/despacho)">
      <bpmn:documentation>Visualiza pedido entrante con detalles de producto y gramaje solicitado.</bpmn:documentation>
      <bpmn:incoming>Lab_F2</bpmn:incoming>
      <bpmn:outgoing>Lab_F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Lab_ConnectBalanza" name="Lectura Web Serial Balanza Digital">
      <bpmn:documentation>Web Serial API lee puerto COM / USB (precisión ±2g).</bpmn:documentation>
      <bpmn:incoming>Lab_F3</bpmn:incoming>
      <bpmn:outgoing>Lab_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Task_Lab_TaraPesaje" name="Tara de Bowl y Dosificación de Químicos">
      <bpmn:documentation>Coloca bowl, tara a 0.0g y añade tintes/peróxidos.</bpmn:documentation>
      <bpmn:incoming>Lab_F4</bpmn:incoming>
      <bpmn:incoming>Lab_F6</bpmn:incoming>
      <bpmn:outgoing>Lab_F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gate_Lab_Tolerancia" name="¿Pesaje Dentro de Tolerancia (±2g)?">
      <bpmn:documentation>Valida si el peso real coincide con la fórmula química.</bpmn:documentation>
      <bpmn:incoming>Lab_F5</bpmn:incoming>
      <bpmn:outgoing>Lab_F6</bpmn:outgoing>
      <bpmn:outgoing>Lab_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Lab_ConfirmarDespacho" name="Confirmación y Despacho Físico">
      <bpmn:documentation>Registra el peso exacto real y despacha el bowl.</bpmn:documentation>
      <bpmn:incoming>Lab_F7</bpmn:incoming>
      <bpmn:outgoing>Lab_F8</bpmn:outgoing>
      <bpmn:outgoing>Lab_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Kardex_Deduccion" name="Deducción Automática en Kardex">
      <bpmn:documentation>Inserta fila en public.inventario_movimientos con tipo SALIDA_CONSUMO.</bpmn:documentation>
      <bpmn:incoming>Lab_F9</bpmn:incoming>
      <bpmn:outgoing>Lab_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Kardex_Minimo" name="¿Stock &lt; Umbral Mínimo?">
      <bpmn:documentation>Compara stock restante vs. punto de reorden configurado.</bpmn:documentation>
      <bpmn:incoming>Lab_F14</bpmn:incoming>
      <bpmn:outgoing>Lab_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Kardex_Alerta" name="Emisión de Alerta de Reabastecimiento">
      <bpmn:documentation>Notifica al administrador y activa badge de insumo por agotarse.</bpmn:documentation>
      <bpmn:incoming>Lab_F15</bpmn:incoming>
      <bpmn:outgoing>Lab_F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Compras_OpalPredictor" name="Proyección de Demanda 7 Días con Opal AI">
      <bpmn:documentation>LabInsumosPredictorOpal.tsx proyecta consumo por citas agendadas.</bpmn:documentation>
      <bpmn:incoming>Lab_F16</bpmn:incoming>
      <bpmn:outgoing>Lab_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Compras_GenerarOC" name="Generación de Orden de Compra o Traslado">
      <bpmn:documentation>Aprobación de orden a proveedor o transferencia entre sedes.</bpmn:documentation>
      <bpmn:incoming>Lab_F17</bpmn:incoming>
      <bpmn:outgoing>Lab_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Lab_StockOk" name="Reposición Programada">
      <bpmn:documentation>Insumo reabastecido en Kardex.</bpmn:documentation>
      <bpmn:incoming>Lab_F18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Lab_F1" sourceRef="Start_Lab_Req" targetRef="Task_Estil_Formulacion" />
    <bpmn:sequenceFlow id="Lab_F2" sourceRef="Task_Estil_Formulacion" targetRef="Task_Lab_MonitorDespacho" />
    <bpmn:sequenceFlow id="Lab_F3" sourceRef="Task_Lab_MonitorDespacho" targetRef="Task_Lab_ConnectBalanza" />
    <bpmn:sequenceFlow id="Lab_F4" sourceRef="Task_Lab_ConnectBalanza" targetRef="Task_Lab_TaraPesaje" />
    <bpmn:sequenceFlow id="Lab_F5" sourceRef="Task_Lab_TaraPesaje" targetRef="Gate_Lab_Tolerancia" />
    <bpmn:sequenceFlow id="Lab_F6" sourceRef="Gate_Lab_Tolerancia" targetRef="Task_Lab_TaraPesaje" name="Fuera de Tolerancia" />
    <bpmn:sequenceFlow id="Lab_F7" sourceRef="Gate_Lab_Tolerancia" targetRef="Task_Lab_ConfirmarDespacho" name="Dentro de ±2g" />
    <bpmn:sequenceFlow id="Lab_F8" sourceRef="Task_Lab_ConfirmarDespacho" targetRef="Task_Estil_RecibeBowl" />
    <bpmn:sequenceFlow id="Lab_F9" sourceRef="Task_Lab_ConfirmarDespacho" targetRef="Task_Kardex_Deduccion" />
    <bpmn:sequenceFlow id="Lab_F10" sourceRef="Task_Estil_RecibeBowl" targetRef="Task_Estil_Aplicar" />
    <bpmn:sequenceFlow id="Lab_F11" sourceRef="Task_Estil_Aplicar" targetRef="Event_Estil_TimerExp" />
    <bpmn:sequenceFlow id="Lab_F12" sourceRef="Event_Estil_TimerExp" targetRef="Task_Estil_Sobrante" />
    <bpmn:sequenceFlow id="Lab_F13" sourceRef="Task_Estil_Sobrante" targetRef="End_Lab_Serv" />
    <bpmn:sequenceFlow id="Lab_F14" sourceRef="Task_Kardex_Deduccion" targetRef="Gate_Kardex_Minimo" />
    <bpmn:sequenceFlow id="Lab_F15" sourceRef="Gate_Kardex_Minimo" targetRef="Task_Kardex_Alerta" name="Stock Bajo" />
    <bpmn:sequenceFlow id="Lab_F16" sourceRef="Task_Kardex_Alerta" targetRef="Task_Compras_OpalPredictor" />
    <bpmn:sequenceFlow id="Lab_F17" sourceRef="Task_Compras_OpalPredictor" targetRef="Task_Compras_GenerarOC" />
    <bpmn:sequenceFlow id="Lab_F18" sourceRef="Task_Compras_GenerarOC" targetRef="End_Lab_StockOk" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Lab_Suministros">
    <bpmndi:BPMNPlane id="BPMNPlane_Lab_Suministros" bpmnElement="Collaboration_Lab_Suministros">
      <bpmndi:BPMNShape id="Participant_Lab_Suministros_di" bpmnElement="Participant_Lab_Suministros" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="2700" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lab_Estil_di" bpmnElement="Lane_Lab_Estil" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="2670" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lab_Quimico_di" bpmnElement="Lane_Lab_Quimico" isHorizontal="true">
        <dc:Bounds x="130" y="260" width="2670" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lab_Kardex_di" bpmnElement="Lane_Lab_Kardex" isHorizontal="true">
        <dc:Bounds x="130" y="460" width="2670" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lab_Compras_di" bpmnElement="Lane_Lab_Compras" isHorizontal="true">
        <dc:Bounds x="130" y="610" width="2670" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_Lab_Formula_di" bpmnElement="DO_Lab_Formula">
        <dc:Bounds x="380" y="220" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lab_Kardex_di" bpmnElement="DS_Lab_Kardex">
        <dc:Bounds x="1190" y="585" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Lab_Req_di" bpmnElement="Start_Lab_Req">
        <dc:Bounds x="180" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Estil_Formulacion_di" bpmnElement="Task_Estil_Formulacion">
        <dc:Bounds x="260" y="138" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Estil_RecibeBowl_di" bpmnElement="Task_Estil_RecibeBowl">
        <dc:Bounds x="1350" y="138" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Estil_Aplicar_di" bpmnElement="Task_Estil_Aplicar">
        <dc:Bounds x="1540" y="138" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Estil_TimerExp_di" bpmnElement="Event_Estil_TimerExp">
        <dc:Bounds x="1720" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Estil_Sobrante_di" bpmnElement="Task_Estil_Sobrante">
        <dc:Bounds x="1810" y="138" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Lab_Serv_di" bpmnElement="End_Lab_Serv">
        <dc:Bounds x="2000" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Lab_MonitorDespacho_di" bpmnElement="Task_Lab_MonitorDespacho">
        <dc:Bounds x="450" y="330" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Lab_ConnectBalanza_di" bpmnElement="Task_Lab_ConnectBalanza">
        <dc:Bounds x="650" y="330" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Lab_TaraPesaje_di" bpmnElement="Task_Lab_TaraPesaje">
        <dc:Bounds x="850" y="330" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_Lab_Tolerancia_di" bpmnElement="Gate_Lab_Tolerancia">
        <dc:Bounds x="1040" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Lab_ConfirmarDespacho_di" bpmnElement="Task_Lab_ConfirmarDespacho">
        <dc:Bounds x="1150" y="330" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Kardex_Deduccion_di" bpmnElement="Task_Kardex_Deduccion">
        <dc:Bounds x="1150" y="505" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gate_Kardex_Minimo_di" bpmnElement="Gate_Kardex_Minimo">
        <dc:Bounds x="1350" y="510" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Kardex_Alerta_di" bpmnElement="Task_Kardex_Alerta">
        <dc:Bounds x="1470" y="505" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compras_OpalPredictor_di" bpmnElement="Task_Compras_OpalPredictor">
        <dc:Bounds x="1470" y="650" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compras_GenerarOC_di" bpmnElement="Task_Compras_GenerarOC">
        <dc:Bounds x="1680" y="650" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Lab_StockOk_di" bpmnElement="End_Lab_StockOk">
        <dc:Bounds x="1900" y="662" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Lab_F1_di" bpmnElement="Lab_F1">
        <di:waypoint x="216" y="168" />
        <di:waypoint x="260" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F2_di" bpmnElement="Lab_F2">
        <di:waypoint x="400" y="168" />
        <di:waypoint x="425" y="168" />
        <di:waypoint x="425" y="360" />
        <di:waypoint x="450" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F3_di" bpmnElement="Lab_F3">
        <di:waypoint x="590" y="360" />
        <di:waypoint x="650" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F4_di" bpmnElement="Lab_F4">
        <di:waypoint x="790" y="360" />
        <di:waypoint x="850" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F5_di" bpmnElement="Lab_F5">
        <di:waypoint x="990" y="360" />
        <di:waypoint x="1040" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F6_di" bpmnElement="Lab_F6">
        <di:waypoint x="1065" y="335" />
        <di:waypoint x="1065" y="290" />
        <di:waypoint x="920" y="290" />
        <di:waypoint x="920" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F7_di" bpmnElement="Lab_F7">
        <di:waypoint x="1090" y="360" />
        <di:waypoint x="1150" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F8_di" bpmnElement="Lab_F8">
        <di:waypoint x="1220" y="330" />
        <di:waypoint x="1220" y="168" />
        <di:waypoint x="1350" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F9_di" bpmnElement="Lab_F9">
        <di:waypoint x="1220" y="390" />
        <di:waypoint x="1220" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F10_di" bpmnElement="Lab_F10">
        <di:waypoint x="1480" y="168" />
        <di:waypoint x="1540" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F11_di" bpmnElement="Lab_F11">
        <di:waypoint x="1670" y="168" />
        <di:waypoint x="1720" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F12_di" bpmnElement="Lab_F12">
        <di:waypoint x="1756" y="168" />
        <di:waypoint x="1810" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F13_di" bpmnElement="Lab_F13">
        <di:waypoint x="1940" y="168" />
        <di:waypoint x="2000" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F14_di" bpmnElement="Lab_F14">
        <di:waypoint x="1290" y="535" />
        <di:waypoint x="1350" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F15_di" bpmnElement="Lab_F15">
        <di:waypoint x="1400" y="535" />
        <di:waypoint x="1470" y="535" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F16_di" bpmnElement="Lab_F16">
        <di:waypoint x="1545" y="565" />
        <di:waypoint x="1545" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F17_di" bpmnElement="Lab_F17">
        <di:waypoint x="1620" y="680" />
        <di:waypoint x="1680" y="680" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Lab_F18_di" bpmnElement="Lab_F18">
        <di:waypoint x="1830" y="680" />
        <di:waypoint x="1900" y="680" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>