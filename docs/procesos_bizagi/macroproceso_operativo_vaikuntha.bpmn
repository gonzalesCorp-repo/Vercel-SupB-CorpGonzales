<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
  id="Definitions_Macro_Salón" 
  targetNamespace="http://bpmn.io/schema/bpmn" 
  exporter="Vaikuntha ERP Bizagi BPMN Generator" 
  exporterVersion="2.2">
  <bpmn:dataStore id="DataStore_DS_SupabaseOatc" name="(BD) Supabase: public.oatc">
    <bpmn:documentation>Tabla central de órdenes de atención y colas de espera con Realtime Channel.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:dataStore id="DataStore_DS_SupabaseColaPet" name="(BD) Supabase: public.cola_peticiones">
    <bpmn:documentation>Cola asíncrona para comandas de bar, solicitudes químicas y peticiones WFM.</bpmn:documentation>
  </bpmn:dataStore>
  <bpmn:collaboration id="Collaboration_Macro_Salón">
    <bpmn:participant id="Participant_Macro_Salón" name="Macroproceso Operativo de Salón - Vaikuntha ERP (Gloss Salon &amp; Relax)" processRef="Process_Macro_Salón" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Macro_Salón" name="Macroproceso Operativo de Salón - Vaikuntha ERP (Gloss Salon &amp; Relax)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Macro_Salón">
      <bpmn:lane id="Lane_Cli" name="Cliente VIP / Visitante">
        <bpmn:flowNodeRef>Start_Cliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cli_CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Cli_EsperaTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cli_Sillon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cli_Servicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cli_Pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cliente</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kiosk" name="Kiosko Táctil / Concierge Opal AI">
        <bpmn:flowNodeRef>Task_Kiosk_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Kiosk_Cita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kiosk_Opal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_OATC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Kiosk_MsgLlegada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recep" name="Recepción Central">
        <bpmn:flowNodeRef>Event_Recep_MsgCatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Recep_Asig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recep_Asignar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Estil" name="Estilista / Cosmiatra en Sillón">
        <bpmn:flowNodeRef>Task_Estil_Reclamar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_Diag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_Estil_Reqs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_PedLab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_PedBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Estil_LabCatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Estil_BarCatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Estil_Cronometro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_Ejecutar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Estil_FinServ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lab" name="Laboratorio Químico">
        <bpmn:flowNodeRef>Task_Lab_Pesar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Lab_ThrowDespacho</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bar" name="Bar Boutique &amp; Cafetería">
        <bpmn:flowNodeRef>Task_Bar_Prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Bar_ThrowListo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Caja" name="Caja POS &amp; Facturación">
        <bpmn:flowNodeRef>Task_Caja_Cargar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Caja_Cobro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Caja_Boleta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataObject id="DO_TicketOatc" name="Ticket OATC Térmico (80mm ESC/POS)">
      <bpmn:documentation>Ticket físico generado con código de barras, QR de seguimiento, estilista y servicios solicitados.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObject id="DO_FichaCapilar" name="Ficha Técnica Capilar">
      <bpmn:documentation>Diagnóstico biométrico y formulación química registrada en StaffChairsideAssistant.tsx.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataObject id="DO_ComprobanteSunat" name="Comprobante SUNAT (Boleta/Factura)">
      <bpmn:documentation>Documento tributario emitido electrónicamente con validación fiscal.</bpmn:documentation>
    </bpmn:dataObject>
    <bpmn:dataStoreReference id="DS_SupabaseOatc" name="(BD) Supabase: public.oatc" dataStoreRef="DataStore_DS_SupabaseOatc">
      <bpmn:documentation>Tabla central de órdenes de atención y colas de espera con Realtime Channel.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DS_SupabaseColaPet" name="(BD) Supabase: public.cola_peticiones" dataStoreRef="DataStore_DS_SupabaseColaPet">
      <bpmn:documentation>Cola asíncrona para comandas de bar, solicitudes químicas y peticiones WFM.</bpmn:documentation>
    </bpmn:dataStoreReference>

    <bpmn:startEvent id="Start_Cliente" name="Llegada al Salón">
      <bpmn:documentation>El cliente VIP o espontáneo ingresa al salón.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Cli_CheckIn" name="Interacción en Kiosko / Check-in">
      <bpmn:documentation>Digita DNI o celular en pantalla táctil del tótem o consulta con recepción.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Cli_EsperaTimer" name="Espera en Lounge (Tiempo Estimado)">
      <bpmn:documentation>Espera confortable en lounge; Opal AI estima el tiempo de preparación del sillón.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:timerEventDefinition id="TimerDef_Event_Cli_EsperaTimer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Cli_Sillon" name="Traslado a Sillón de Estilista">
      <bpmn:documentation>El cliente es llamado y se acomoda en la estación del estilista.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Cli_Servicio" name="Recepción de Servicio &amp; Consulta Lumina Club">
      <bpmn:documentation>El cliente disfruta su servicio y visualiza en su app móvil recomendaciones y saldo de LuminaCoins.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_Cli_Pago" name="Validación de Pre-cuenta &amp; Pago">
      <bpmn:documentation>El cliente revisa su cuenta en Caja POS y efectúa el pago.</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Cliente" name="Salida del Salón con Puntos Ganados">
      <bpmn:documentation>Atención finalizada satisfactoriamente y acumulación de puntos registrada.</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Kiosk_Search" name="Búsqueda de Cliente &amp; Cita en Supabase">
      <bpmn:documentation>KioskVipCheckIn.tsx consulta public.clientes.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gate_Kiosk_Cita" name="¿Tiene Cita Programada?">
      <bpmn:documentation>Evalúa si el cliente cuenta con cita en agenda o ingresa por demanda espontánea.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Kiosk_Opal" name="Bienvenida &amp; Sugerencia Opal Concierge">
      <bpmn:documentation>KioskConciergeAgent.tsx infiere bebida de bienvenida y tiempo estimado.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="SubProcess_OATC" name="Subproceso: Gestión y Emisión Térmica de OATC" calledElement="Process_Sub_OATC">
      <bpmn:documentation>Subproceso reutilizable: Generación de OATC, guardado en Supabase, renderizado ESC/POS y despacho a impresora térmica de sede.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateThrowEvent id="Event_Kiosk_MsgLlegada" name="Emitir Llegada de Cliente en Realtime">
      <bpmn:documentation>Dispara evento en Realtime Channel hacia el monitor central de recepción.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Event_Kiosk_MsgLlegada" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_Recep_MsgCatch" name="Recepción Realtime: Cliente en Sala">
      <bpmn:documentation>QueueMonitor.tsx captura la notificación con aviso sonoro y toast.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Event_Recep_MsgCatch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gate_Recep_Asig" name="¿Orden Tiene Estilista Asignado?">
      <bpmn:documentation>Verifica si la OATC ya cuenta con especialista asignado.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Recep_Asignar" name="Asignación Manual o Reagendamiento">
      <bpmn:documentation>Recepción asigna estilista según rotación de piso o brinda tiempo estimado al cliente.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Estil_Reclamar" name="Reclamación de Orden en Móvil (TabCola)">
      <bpmn:documentation>El estilista visualiza la orden y presiona &quot;Atender en mi Sillón&quot;.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Estil_Diag" name="Diagnóstico Capilar (StaffChairsideAssistant)">
      <bpmn:documentation>Registro de diagnóstico y selección de fórmulas químicas.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gate_Estil_Reqs" name="Requerimientos de Atención">
      <bpmn:documentation>Dispara en paralelo solicitud a Laboratorio (químicos) y/o Bar (cortesías).</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Estil_PedLab" name="Solicitud de Fórmula a Laboratorio">
      <bpmn:documentation>Solicita preparación de tintes/decolorantes con gramaje estimado.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Estil_PedBar" name="Comanda de Bebida a Bar (TabBar)">
      <bpmn:documentation>Comanda de cortesía en cola_peticiones (BAR_BEBIDA).</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Estil_LabCatch" name="Aviso: Mezcla Química Lista">
      <bpmn:documentation>Captura notificación de que el bowl químico está pesado y listo.</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Event_Estil_LabCatch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Estil_BarCatch" name="Aviso: Bebida de Bar Lista">
      <bpmn:documentation>Captura notificación de que la bebida de cortesía está servida.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Event_Estil_BarCatch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Estil_Cronometro" name="Cronómetro Exposición Química (20-45m)">
      <bpmn:documentation>Alarma de exposición química cumplida para enjuague y lavado.</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Event_Estil_Cronometro">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Estil_Ejecutar" name="Finalización de Servicio y Peinado">
      <bpmn:documentation>Peinado, brushing y venta cruzada sugerida por Opal Copilot.</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_Estil_FinServ" name="Finalizar Servicio &amp; Derivar a Caja POS">
      <bpmn:documentation>Marca orden OATC como COMPLETADO y notifica al módulo de Caja.</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Lab_Pesar" name="Pesaje en Balanza Web Serial (±2g)">
      <bpmn:documentation>Lectura en tiempo real de balanza digital y dosificación exacta.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_Lab_ThrowDespacho" name="Notificar Mezcla Química Lista">
      <bpmn:documentation>Emite aviso de bowl listo hacia el estilista solicitante.</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Event_Lab_ThrowDespacho" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_Bar_Prep" name="Preparación de Bebida / Café Especial">
      <bpmn:documentation>BarWorkspaceView.tsx reproduce campana Web Audio y barista prepara.</bpmn:documentation>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_Bar_ThrowListo" name="Notificar Bebida de Bar Lista">
      <bpmn:documentation>Emite aviso de comanda servida hacia el cliente/estilista.</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Event_Bar_ThrowListo" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_Caja_Cargar" name="Carga de Orden OATC &amp; Liquidación">
      <bpmn:documentation>Cajero audita orden OATC, ítems de cortesía y servicios ejecutados.</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Caja_Cobro" name="Cobro Multimoneda &amp; Propinas">
      <bpmn:documentation>Cobro en efectivo/tarjeta/Yape y asignación de propina para staff.</bpmn:documentation>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Caja_Boleta" name="Emisión Boleta SUNAT &amp; Puntos Lumina">
      <bpmn:documentation>Emite comprobante electrónico y suma LuminaCoins en cuenta del cliente.</bpmn:documentation>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Cliente" targetRef="Task_Cli_CheckIn" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Cli_CheckIn" targetRef="Task_Kiosk_Search" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Kiosk_Search" targetRef="Gate_Kiosk_Cita" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gate_Kiosk_Cita" targetRef="Task_Kiosk_Opal" name="Con Cita" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gate_Kiosk_Cita" targetRef="SubProcess_OATC" name="Sin Cita" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Kiosk_Opal" targetRef="Event_Cli_EsperaTimer" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Kiosk_Opal" targetRef="SubProcess_OATC" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="SubProcess_OATC" targetRef="Event_Kiosk_MsgLlegada" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Event_Kiosk_MsgLlegada" targetRef="Event_Recep_MsgCatch" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_Recep_MsgCatch" targetRef="Gate_Recep_Asig" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gate_Recep_Asig" targetRef="Task_Recep_Asignar" name="Sin Asignar" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gate_Recep_Asig" targetRef="Task_Estil_Reclamar" name="Asignado" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Recep_Asignar" targetRef="Task_Estil_Reclamar" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Estil_Reclamar" targetRef="Task_Cli_Sillon" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Estil_Reclamar" targetRef="Task_Estil_Diag" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Estil_Diag" targetRef="Gate_Estil_Reqs" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gate_Estil_Reqs" targetRef="Task_Estil_PedLab" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gate_Estil_Reqs" targetRef="Task_Estil_PedBar" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gate_Estil_Reqs" targetRef="Task_Cli_Servicio" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Estil_PedLab" targetRef="Task_Lab_Pesar" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Lab_Pesar" targetRef="Event_Lab_ThrowDespacho" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Event_Lab_ThrowDespacho" targetRef="Event_Estil_LabCatch" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Estil_PedBar" targetRef="Task_Bar_Prep" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Bar_Prep" targetRef="Event_Bar_ThrowListo" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Event_Bar_ThrowListo" targetRef="Event_Estil_BarCatch" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Event_Estil_LabCatch" targetRef="Event_Estil_Cronometro" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Event_Estil_BarCatch" targetRef="Event_Estil_Cronometro" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Event_Estil_Cronometro" targetRef="Task_Estil_Ejecutar" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Estil_Ejecutar" targetRef="Task_Estil_FinServ" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_Estil_FinServ" targetRef="Task_Caja_Cargar" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Caja_Cargar" targetRef="Task_Caja_Cobro" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_Caja_Cobro" targetRef="Task_Cli_Pago" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_Cli_Pago" targetRef="Task_Caja_Boleta" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_Caja_Boleta" targetRef="End_Cliente" />
  </bpmn:process>
